<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_capabilities</name>
  <version>0.1.0</version>
  <description>Capability-layer orchestration for mobile-manipulator feasibility, fallback, and execution policy.</description>
  <maintainer email="kalanaratnayake95@gmail.com">ubuntu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>capabilities2_events</depend>
  <depend>capabilities2_msgs</depend>
  <depend>capabilities2_runner</depend>
  <depend>mobile_manipulator_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>

    <capability_interface>
      interfaces/CheckTaskFeasibilityRunner.yaml
    </capability_interface>

    <capability_provider>
      providers/CheckTaskFeasibilityRunner.yaml
    </capability_provider>

    <capability_interface>
      interfaces/FindFeasiblePoseRunner.yaml
    </capability_interface>

    <capability_provider>
      providers/FindFeasiblePoseRunner.yaml
    </capability_provider>

    <capability_interface>
      interfaces/ExecuteTaskPoseRunner.yaml
    </capability_interface>

    <capability_provider>
      providers/ExecuteTaskPoseRunner.yaml
    </capability_provider>
  </export>
</package>